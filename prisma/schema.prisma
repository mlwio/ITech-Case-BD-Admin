// ---------------------------------------------------------------------------
// ITech Case BD — Order Management SaaS
// Prisma schema (MongoDB)
//
//   Local / Atlas :  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/itechcasebd
//
//   npx prisma generate && npx prisma db push
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (stored as strings on MongoDB)
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  MODERATOR
  PACKING_STAFF
}

enum OrderStatus {
  PLACED
  CONFIRMED
  HOLD
  CANCELLED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum OrderSource {
  MESSENGER
  WHATSAPP
  TIKTOK
  WEBSITE
  LANDING_PAGE
  CALL
}

enum ExpenseCategory {
  AD_SPEND
  PACKAGING
  SALARY
  OTHER
}

enum DeliveryZone {
  DHAKA
  CHITTAGONG
  SYLHET
  OTHER
}

enum PathaoEnvironment {
  SANDBOX
  PRODUCTION
}

enum InventoryMovementReason {
  RESTOCK
  MANUAL_ADJUSTMENT
  ORDER_CONFIRMED
  ORDER_CANCELLED
  ORDER_RETURNED
  DAMAGE
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Shop {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  logo          String?
  primaryColor  String   @default("#4f46e5")
  customDomain  String?  @unique
  phone         String?
  address       String?
  currency      String   @default("BDT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       ShopMember[]
  products      Product[]
  customers     Customer[]
  orders        Order[]
  expenses      ExpenseLog[]
  auditLogs     OrderAuditLog[]
  trackingEvents ParcelTrackingEvent[]
  courierCredential CourierCredential?
  inventoryMovements InventoryMovement[]

  @@map("shops")
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  phone         String?
  avatar        String?
  passwordHash  String?
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   ShopMember[]
  ordersCreated Order[]        @relation("OrderCreatedBy")

  @@map("users")
}

model ShopMember {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  shopId        String     @db.ObjectId
  userId        String     @db.ObjectId
  role          MemberRole @default(MODERATOR)

  // Granular permission toggles surfaced in "Moderators & Settings".
  canAccessOrders    Boolean @default(true)
  canAccessProducts  Boolean @default(false)
  canAccessCustomers Boolean @default(true)
  canAccessFinance   Boolean @default(false)
  canAccessInventory Boolean @default(false)

  isActive      Boolean  @default(true)
  invitedAt     DateTime @default(now())
  joinedAt      DateTime?

  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("shop_members")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId      String   @db.ObjectId
  name        String
  brand       String
  category    String
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]

  @@index([shopId])
  @@index([shopId, brand])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  productId         String   @db.ObjectId
  name              String   // e.g. "Midnight Blue"
  sku               String   @unique
  color             String
  costPrice         Float
  sellingPrice      Float
  stockQty          Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  movements         InventoryMovement[]

  @@index([productId])
  // Stock-In looks a colour up by (productId, color) — this keeps it index-only.
  @@index([productId, color])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId          String   @db.ObjectId
  name            String
  phone           String
  address         String
  zone            DeliveryZone @default(DHAKA)
  totalOrders     Int      @default(0)
  deliveredCount  Int      @default(0)
  returnedCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@unique([shopId, phone])
  @@index([shopId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId           String   @db.ObjectId
  orderNumber      String   @unique
  customerId       String   @db.ObjectId
  status           OrderStatus @default(PLACED)
  source           OrderSource @default(MESSENGER)
  deliveryZone     DeliveryZone @default(DHAKA)
  deliveryCharge   Float  @default(0)
  discount         Float  @default(0)
  subtotal         Float  @default(0)
  totalAmount      Float  @default(0)
  courierName      String   @default("Pathao")
  consignmentId    String?
  pathaoStatus     String?
  courierFee       Float    @default(0)
  isPaymentSettled Boolean  @default(false)
  note             String?
  createdById      String   @db.ObjectId
  placedAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shop             Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy        User         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items            OrderItem[]
  auditLogs        OrderAuditLog[]
  trackingEvents   ParcelTrackingEvent[]

  // Covers the orders inbox (filter by status, newest first) in one index.
  @@index([shopId, status, placedAt])
  @@index([shopId, placedAt])
  @@index([customerId])
  @@index([consignmentId])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId       String  @db.ObjectId
  variantId     String  @db.ObjectId
  productName   String
  variantName   String
  sku           String
  quantity      Int     @default(1)
  unitPrice     Float
  unitCostPrice Float @default(0)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Finance & audit
// ---------------------------------------------------------------------------

model ExpenseLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId      String   @db.ObjectId
  date        DateTime @default(now())
  category    ExpenseCategory
  amountBdt   Float
  note        String
  createdById String?
  createdAt   DateTime @default(now())

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, date])
  @@index([shopId, category])
  @@map("expense_logs")
}

model OrderAuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId      String   @db.ObjectId
  orderId     String   @db.ObjectId
  action      String
  details     String
  performedBy String
  createdAt   DateTime @default(now())

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shopId, createdAt])
  @@map("order_audit_logs")
}

// ---------------------------------------------------------------------------
// Courier — Pathao Merchant API (Phase 3)
// ---------------------------------------------------------------------------

/// One row per shop holding the Pathao merchant credentials plus the cached
/// OAuth tokens issued by `/aladdin/api/v1/issue-token`.
model CourierCredential {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  shopId        String            @unique @db.ObjectId
  provider      String            @default("PATHAO")
  environment   PathaoEnvironment @default(SANDBOX)

  clientId      String?
  clientSecret  String?
  username      String?
  password      String?
  storeId       String?
  webhookSecret String?

  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?

  pickupStoreId   String?
  pickupStoreName String?

  isActive        Boolean   @default(true)
  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestMessage String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("courier_credentials")
}

/// Immutable, append-only Pathao lifecycle feed that powers the parcel state
/// timeline inside the order drawer.
model ParcelTrackingEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId        String   @db.ObjectId
  orderId       String   @db.ObjectId
  consignmentId String?
  status        String
  message       String?
  source        String   @default("PATHAO")
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([consignmentId])
  @@index([shopId, occurredAt])
  @@map("parcel_tracking_events")
}

/// Raw webhook deliveries from Pathao, kept for auditing & replay.
model PathaoWebhookEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  consignmentId String?
  orderId       String?
  status        String?
  signatureValid Boolean @default(false)
  payload       String
  receivedAt    DateTime @default(now())

  @@index([consignmentId])
  @@index([receivedAt])
  @@map("pathao_webhook_events")
}

// ---------------------------------------------------------------------------
// Inventory — variant stock movement log (Phase 4)
// ---------------------------------------------------------------------------

/// Append-only stock ledger. Every restock, manual edit, damage write-off and
/// automatic order deduction/restock is recorded here so the matrix always has
/// a traceable history (spec: "records stock movements in inventory logs").
model InventoryMovement {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  shopId       String                  @db.ObjectId
  variantId    String                  @db.ObjectId
  variantName  String
  sku          String
  delta        Int
  reason       InventoryMovementReason
  note         String?
  resultingQty Int
  performedBy  String
  createdAt    DateTime                @default(now())

  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([variantId])
  @@map("inventory_movements")
}
