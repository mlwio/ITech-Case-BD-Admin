// ---------------------------------------------------------------------------
// ITech Case BD — DATABASE 3 (Core Catalog, Finance, Inventory & Admin)
//
//   DATABASE_3_URL owns:
//     • Admin / Moderator access   → Shop, User, ShopMember
//     • Catalog & live stock       → Product, ProductVariant, InventoryMovement
//     • Courier credentials        → CourierCredential
//     • Finance / Hisab            → Expense, FinancialLedger
//
// Generate with:  npx prisma generate --schema=prisma/schema.core.prisma
// Push schema :  npx prisma db push  --schema=prisma/schema.core.prisma
//
// The client is emitted to `node_modules/.prisma/core-client` and consumed as
// `corePrisma` from `src/lib/prisma.ts`.
//
// CROSS-DATABASE DECOUPLING: orders live in Database 1, so there is no
// `@relation` to `Order` / `OrderItem` here. `FinancialLedger.orderId` is an
// indexed scalar string that is joined back to `ordersPrisma.order` in memory.
// ---------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/core-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "mongodb"
  url       = env("DATABASE_3_URL")
  directUrl = env("DIRECT_3_URL")
}

// ---------------------------------------------------------------------------
// Enums (stored as strings on MongoDB)
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  MODERATOR
  PACKING_STAFF
}

/// Lifecycle of an invited moderator account.
///   INVITED  — invite email sent, awaiting registration via the invite link.
///   ACTIVE   — registration complete; the account can sign in.
///   DISABLED — access paused by the owner.
enum InviteStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum InventoryMovementReason {
  RESTOCK
  MANUAL_ADJUSTMENT
  ORDER_CONFIRMED
  ORDER_CANCELLED
  ORDER_RETURNED
  DAMAGE
}

enum PathaoEnvironment {
  SANDBOX
  PRODUCTION
}

enum ExpenseCategory {
  AD_SPEND
  PACKAGING
  SALARY
  OTHER
}

/// What a financial-ledger row represents.
enum LedgerEntryType {
  ORDER_PROFIT
  RETURN_DELIVERY_LOSS
  EXPENSE
  MANUAL_ADJUSTMENT
}

/// Cash-collection state of a ledger row.
enum CollectionStatus {
  /// COD not yet received from the courier.
  PENDING
  /// COD money received / settled into the bank.
  COLLECTED
  /// Returned parcel — no product revenue was ever collected.
  WAIVED_OR_LOST
}

// ---------------------------------------------------------------------------
// Tenancy & access control
// ---------------------------------------------------------------------------

model Shop {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  logo         String?
  primaryColor String   @default("#4f46e5")
  customDomain String?  @unique
  phone        String?
  address      String?
  currency     String   @default("BDT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members            ShopMember[]
  products           Product[]
  expenses           Expense[]
  courierCredential  CourierCredential?
  inventoryMovements InventoryMovement[]
  financialLedger    FinancialLedger[]

  @@map("shops")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String    @unique
  phone        String?
  avatar       String?
  passwordHash String?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Moderator invitation lifecycle (see `InviteStatus`). Null on legacy rows
  /// created before invitations existed — treated as ACTIVE.
  inviteStatus InviteStatus?
  /// Single-use cryptographic token embedded in the invite email link.
  /// Deliberately indexed but *not* `@unique`: MongoDB's unique index treats a
  /// missing value as `null` and would reject a second pending invite.
  inviteToken     String?
  inviteExpiresAt DateTime?

  memberships ShopMember[]

  @@index([inviteToken])
  @@map("users")
}

model ShopMember {
  id     String     @id @default(auto()) @map("_id") @db.ObjectId
  shopId String     @db.ObjectId
  userId String     @db.ObjectId
  role   MemberRole @default(MODERATOR)

  // Granular permission toggles surfaced in "Moderators & Settings".
  canAccessOrders    Boolean @default(true)
  canAccessProducts  Boolean @default(false)
  canAccessCustomers Boolean @default(true)
  canAccessFinance   Boolean @default(false)
  canAccessInventory Boolean @default(false)

  isActive  Boolean   @default(true)
  invitedAt DateTime  @default(now())
  joinedAt  DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("shop_members")
}

// ---------------------------------------------------------------------------
// Catalog & live stock
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId      String   @db.ObjectId
  name        String
  brand       String
  category    String
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([shopId])
  @@index([shopId, brand])
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  productId         String   @db.ObjectId
  name              String // e.g. "Midnight Blue"
  sku               String   @unique
  color             String
  costPrice         Float
  sellingPrice      Float
  stockQty          Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([productId])
  // Stock-In looks a colour up by (productId, color) — this keeps it index-only.
  @@index([productId, color])
  @@map("product_variants")
}

/// Append-only stock ledger. Every restock, manual edit, damage write-off and
/// automatic order deduction/restock is recorded here.
model InventoryMovement {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  shopId       String                  @db.ObjectId
  variantId    String                  @db.ObjectId
  variantName  String
  sku          String
  delta        Int
  reason       InventoryMovementReason
  note         String?
  resultingQty Int
  performedBy  String
  createdAt    DateTime                @default(now())

  shop    Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([variantId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Courier — Pathao Merchant API credentials + cached OAuth tokens
// ---------------------------------------------------------------------------

model CourierCredential {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  shopId      String            @unique @db.ObjectId
  provider    String            @default("PATHAO")
  environment PathaoEnvironment @default(SANDBOX)

  clientId      String?
  clientSecret  String?
  username      String?
  password      String?
  storeId       String?
  webhookSecret String?

  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?

  pickupStoreId   String?
  pickupStoreName String?

  isActive        Boolean   @default(true)
  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("courier_credentials")
}

// ---------------------------------------------------------------------------
// Finance & Hisab
// ---------------------------------------------------------------------------

/// Operating expense log (ad spend, packaging, salary, other).
model Expense {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  shopId      String          @db.ObjectId
  date        DateTime        @default(now())
  category    ExpenseCategory
  amountBdt   Float
  note        String
  createdById String?
  createdAt   DateTime        @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, date])
  @@index([shopId, category])
  @@map("expense_logs")
}

/// Complete order profit/loss, delivery-charge deduction, return-parcel loss
/// and COD collection history. One row per order (orderId is unique).
///
/// `orderId` references Database 1 (`ordersPrisma.order.id`) — a plain indexed
/// scalar because the order lives in another database.
model FinancialLedger {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  shopId           String           @db.ObjectId
  orderId          String?          @unique
  orderNumber      String?
  consignmentId    String?
  type             LedgerEntryType
  collectionStatus CollectionStatus @default(PENDING)

  /// Cash amount tracked against this entry (COD value / 0 for return losses).
  collectedAmount Float @default(0)
  /// subtotal − discount
  productRevenue  Float @default(0)
  /// Σ(item.unitCostPrice × item.quantity)
  productCost     Float @default(0)
  /// actual delivery fee (courierFee, else the order's delivery charge)
  deliveryCharge  Float @default(0)
  /// (totalAmount − deliveryCharge) − productCost, or −returnFee on a return.
  netProfit       Float @default(0)

  note        String?
  collectedAt DateTime?
  collectedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([shopId, collectionStatus])
  @@index([orderNumber])
  @@map("financial_ledger")
}
