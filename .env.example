# ---------------------------------------------------------------------------
# ITech Case BD — Order Management SaaS
# Copy this file to `.env` and fill in real values, then run `npm run db:push`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. Databases — Phase 2 three-database split (MongoDB Atlas)
# ---------------------------------------------------------------------------
# Each Prisma schema points at its own database:
#   Database 1 — Orders & Fulfillment   → prisma/schema.orders.prisma
#   Database 2 — Customers & CRM        → prisma/schema.customers.prisma
#   Database 3 — Core Catalog/Finance/Admin → prisma/schema.core.prisma
#
# Atlas :  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local :  mongodb://localhost:27017/<dbname>
# `DIRECT_*_URL` mirrors the same connection (Prisma accepts `directUrl` for MongoDB).
DATABASE_1_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/itechcasebd_orders?retryWrites=true&w=majority"
DIRECT_1_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/itechcasebd_orders?retryWrites=true&w=majority"

DATABASE_2_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/itechcasebd_customers?retryWrites=true&w=majority"
DIRECT_2_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/itechcasebd_customers?retryWrites=true&w=majority"

DATABASE_3_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/itechcasebd_core?retryWrites=true&w=majority"
DIRECT_3_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/itechcasebd_core?retryWrites=true&w=majority"

# Legacy alias for Database 3.
CORE_DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/itechcasebd_core?retryWrites=true&w=majority"

# Legacy single database — READ ONLY, used only by `scripts/migrate-to-3db.ts`.
DATABASE_URL="mongodb://localhost:27017/itechcasebd?directConnection=true"
DIRECT_URL="mongodb://localhost:27017/itechcasebd?directConnection=true"

# ---------------------------------------------------------------------------
# 2. Authentication
# ---------------------------------------------------------------------------
# HMAC key used to sign the HTTP-only session cookie (HS256 JWT).
# Generate one with:  openssl rand -base64 32
# If omitted, a development fallback is used — NEVER ship that to production.
AUTH_SECRET="change-me-to-a-long-random-32-byte-secret"

# Public base URL of this deployment. Used for absolute links (webhooks, print,
# shareable order links). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Keep this "false" in production. Demo logins and the no-DB owner fallback are
# disabled so every request must authenticate against the real database.
NEXT_PUBLIC_DEMO_MODE="false"

# ---------------------------------------------------------------------------
# 3. Email — transactional SMTP (invite confirmations)
# ---------------------------------------------------------------------------
# Any standard SMTP host works (cPanel / Hostinger / Zoho / Google Workspace …).
# Used to email an invited teammate automatically once they finish onboarding
# (create password → name + phone). Leave blank to disable email — the
# onboarding flow still works, it just skips the confirmation mail.
#
#   SMTP_PORT   587 = STARTTLS (most common) · 465 = implicit TLS
#   SMTP_SECURE "true" for port 465 (auto-detected from the port otherwise)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""          # defaults to SMTP_USER when left blank
MAIL_FROM_NAME="ITech Case BD"

# ---------------------------------------------------------------------------
# 4. Pathao Courier — Merchant API v1 (Aladdin)
# ---------------------------------------------------------------------------
# Get these from the Pathao Merchant panel → Developer / API section.
# Can also be managed in-app at /couriers (Owner only) once the app is running.
PATHAO_API_BASE="https://courier-api-sandbox.pathao.com"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
PATHAO_STORE_ID=""

# Shared secret Pathao sends with every webhook callback to
# /api/webhooks/pathao. Leave blank to disable signature verification in dev.
PATHAO_WEBHOOK_SECRET=""
