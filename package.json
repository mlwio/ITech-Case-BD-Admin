{
  "name": "itech-case-bd-oms",
  "version": "0.1.0",
  "private": true,
  "description": "ITech Case BD — E-Commerce & F-Commerce Order Management SaaS (Phase 1)",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "npm run db:generate:orders && npm run db:generate:customers && npm run db:generate:core",
    "db:generate:legacy": "prisma generate",
    "db:generate:orders": "prisma generate --schema=prisma/schema.orders.prisma",
    "db:generate:customers": "prisma generate --schema=prisma/schema.customers.prisma",
    "db:generate:core": "prisma generate --schema=prisma/schema.core.prisma",
    "db:push": "npm run db:push:orders && npm run db:push:customers && npm run db:push:core",
    "db:push:orders": "prisma db push --schema=prisma/schema.orders.prisma",
    "db:push:customers": "prisma db push --schema=prisma/schema.customers.prisma",
    "db:push:core": "prisma db push --schema=prisma/schema.core.prisma",
    "db:migrate:3db": "npm run db:generate:legacy && tsx scripts/migrate-to-3db.ts",
    "db:studio": "prisma studio",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.11.17",
    "jose": "^6.2.17",
    "lucide-react": "^0.454.0",
    "next": "^14.2.18",
    "nodemailer": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
